# Configure estes valores apenas no servidor / Cloudflare Workers.
# O token de acesso ao dashboard e o token do Agent devem ser distintos.
ALEXIOS_DASHBOARD_TOKEN=replace-with-a-long-random-secret
ALEXIOS_API_BASE_URL=https://your-agent-api.example.com
ALEXIOS_AGENT_TOKEN=replace-with-the-upstream-agent-token
