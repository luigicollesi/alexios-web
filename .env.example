# Segredos do servidor; nunca usar NEXT_PUBLIC_.
# Para Preview, utilizar o DATABASE_URL da branch Neon dev-multi-instance-web-v2.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require

# Compartilhado com cada agente Python (protocolo atual; rotacao por agente sera futura).
ALEXIOS_AGENT_TOKEN=gere-um-token-de-32-caracteres-ou-mais

# Usado somente pelas rotas legadas /v1. Descontinuar apos migracao.
ALEXIOS_DASHBOARD_TOKEN=gere-um-segredo-diferente-do-agente

# V2: HMAC para procurar ALEXIOS_INSTANCE_ID sem gravar segredo em claro.
# Gerar com: openssl rand -hex 32
ALEXIOS_INSTANCE_HASH_KEY=gere-um-segredo-hex-de-64-caracteres

OPENROUTER_API_KEY=sk-or-v1-SUA_CHAVE
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Cartesia Sonic 3.6: SOMENTE no servidor. Várias chaves separadas por vírgulas;
# ao receber quota_exceeded/out of credits, tentar a próxima. Nunca NEXT_PUBLIC_.
CARTESIA_API_KEYS=sk_car_SUA_CHAVE_1,sk_car_SUA_CHAVE_2
CARTESIA_MODEL=sonic-3.6
CARTESIA_VOICE_ID=07b6f895-78b9-4921-8e10-8a21c99c2e8a
# Voz feminina. É utilizada somente quando speech_form=woman.
CARTESIA_WOMAN_VOICE_ID=9904416a-0831-44ea-b8ee-5f145e8f9bbf
# Emoções Cartesia são beta e documentadas somente para inglês.
# Desative com false se o pt-BR ficar artificial ou a API rejeitar emoções.
CARTESIA_EMOTION_ENABLED=true
CARTESIA_LOCALE=pt-BR
CARTESIA_API_VERSION=2026-08-14
